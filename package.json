{
  "name": "@dsh/myco-kb",
  "version": "0.7.1",
  "description": "MyCo-KB — knowledge base management plugin for the DeepSeek Harness: knowledge packages, combination profiles, lifecycle promotion/archival, silent background maintenance, local repo / local global / cloud global management.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "myco": "bin/myco.js"
  },
  "files": [
    "lib",
    "bin",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000",
    "test:host": "node scripts/host-check.mjs",
    "check": "node --check bin/myco.js && node --check lib/index.js && node --check lib/remote.js && node --check lib/tools.js && node --check lib/daemon.js && node --check lib/client.js && node --check lib/core/*.js",
    "links": "bash scripts/dev-links.sh",
    "build:release": "bash scripts/build-release.sh",
    "install:release": "bash scripts/install-release.sh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "license": "MIT"
}
